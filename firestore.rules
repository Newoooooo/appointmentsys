rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated with a valid role
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && getUserRole() == 'staff';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    // User profiles — readable by owner and admins; only system/admin can write
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Services — any authenticated staff/admin can read; only admin can write
    match /services/{serviceId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // Bookings — staff and admin can read/create/update; only admin can delete
    match /bookings/{bookingId} {
      allow read: if isAdminOrStaff();
      allow create: if isAdminOrStaff();
      allow update: if isAdminOrStaff();
      allow delete: if isAdmin();
    }

    // Staff profiles
    match /staff/{staffId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAdminOrStaff();
      allow create, update: if isAdminOrStaff();
      allow delete: if isAdmin();
    }

    // Inquiries — anyone can create; staff/admin can read/update; admin can delete
    match /inquiries/{inquiryId} {
      allow read, update: if isAdminOrStaff();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Tasks (Kanban)
    match /tasks/{taskId} {
      allow read, write: if isAdminOrStaff();
    }

    // History / transactions
    match /history/{historyId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // Fallback: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
